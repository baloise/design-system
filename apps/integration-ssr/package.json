{
  "name": "integration-ssr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-assets": "copyfiles -u 5 \"node_modules/@helvetia-design/core/dist/design-system/**/*\" public/design-system && copyfiles -f node_modules/@helvetia-design/tokens/dist/css/base.tokens.css node_modules/@helvetia-design/styles/dist/css/design-system.css public",
    "predev": "pnpm copy-assets",
    "dev": "tsx watch server.ts",
    "prestart": "pnpm copy-assets",
    "start": "tsx server.ts",
    "prebuild": "pnpm copy-assets",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "play:run": "pnpm exec playwright test"
  },
  "dependencies": {
    "@helvetia-design/core": "workspace:*",
    "@helvetia-design/styles": "workspace:*",
    "@helvetia-design/tokens": "workspace:*",
    "express": "catalog:"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.13.5",
    "copyfiles": "2.4.1",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
