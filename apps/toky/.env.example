# GitHub token used server-side to read/write *.tokens.json in the design-system repo and
# open pull requests. A fine-grained PAT scoped to just this repo, with Contents
# (read/write) and Pull requests (write), is preferred over a classic "repo"-scoped PAT —
# "repo" grants access to every repo the token owner can push to, not just this one. See
# docs/adr/0003-github-oauth-sign-in-bot-pat-writes.md.
TOKY_GITHUB_TOKEN=

# GitHub token used server-side to check baloise org membership for sign-in authorization
# (GET /orgs/baloise/members/{username}). A separate fine-grained PAT scoped to the
# baloise org (Organization permissions → Members: read-only, no repo access at all) is
# preferred over reusing TOKY_GITHUB_TOKEN's repo-write credential for this — a fine-
# grained PAT can only target one resource owner (a repo owner or an org), so this can't
# be folded into TOKY_GITHUB_TOKEN without going back to a broader classic PAT. Falls back
# to TOKY_GITHUB_TOKEN if unset, so a single classic PAT with "repo" + "read:org" scopes
# still works. See docs/adr/0003-github-oauth-sign-in-bot-pat-writes.md.
TOKY_GITHUB_ORG_TOKEN=

# Branch to read tokens from and open pull requests against. Defaults to "next" if unset.
TOKY_GITHUB_REF=

# GitHub OAuth App credentials for end-user sign-in (Auth.js's GitHub provider — read:user
# scope only, never used for writes or the org check). See
# docs/adr/0003-github-oauth-sign-in-bot-pat-writes.md.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Secret Auth.js uses to sign/encrypt session JWTs. Generate with `npx auth secret` or
# `openssl rand -base64 33`. Required in production.
AUTH_SECRET=

# Set to "true" to skip GitHub sign-in entirely when running `pnpm toky` locally, for fast
# manual testing. Has no effect when VERCEL is set, so it can never bypass auth on a real
# deployment. Leave unset to test the real sign-in flow.
TOKY_DISABLE_AUTH=

# Set to "true" to read packages/tokens/tokens/*.tokens.json straight off disk instead of
# fetching from GitHub, so local uncommitted token edits show up in the editor without a
# commit+push+PR round-trip. Read-only — the "Submit" flow always re-fetches from GitHub at
# submit time regardless of this setting. Has no effect when VERCEL is set, so it can never
# read a local file that doesn't exist on a real deployment. Leave unset to always read from
# GitHub, matching production.
TOKY_LOCAL_TOKENS=

# Figma personal access token used server-side to read Figma Variables for Pull (from
# Figma). Same credential as the repo-root FIGMA_API_TOKEN used by scripts/figma-sync.
FIGMA_API_TOKEN=

# The Figma file key Pull (from Figma) reads variables from. Same as repo-root FIGMA_FILE_KEY.
FIGMA_FILE_KEY=

# URL of the packages/core dev-server page the Live Preview sidebar embeds in an iframe.
# Defaults to http://localhost:4000/playground.html (packages/core's `pnpm start` port) if unset -
# only set this if you're running core's dev-server on a different port. See
# apps/toky/CONTEXT.md's "Live Preview" entry.
NEXT_PUBLIC_DS_PREVIEW_URL=
