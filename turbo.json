{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "BAL_DOCUMENTATION",
    "DS_DOCUMENTATION",
    "DS_RELEASE",
    "DS_DEVELOPMENT",
    "DS_PLAYWRIGHT_TESTING",
    "DS_TESTING",
    "TOKY_GITHUB_TOKEN",
    "TOKY_GITHUB_ORG_TOKEN",
    "TOKY_GITHUB_REF",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "AUTH_SECRET",
    "FIGMA_API_TOKEN",
    "FIGMA_FILE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "app/**", "!**/*.spec.*", "!**/*.play.*"],
      "outputs": ["dist/**", "www/**", "docs/**", "components/**", "loader/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "app/**", "test/**"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", "app/**", "eslint.config.*"],
      "outputs": []
    },
    "optimize": {
      "inputs": ["src/**/svg/*.svg"],
      "outputs": ["src/**/svg.ts", "src/**/svg.json"]
    }
  }
}
