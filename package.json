{
  "name": "design-system",
  "version": "0.0.0",
  "homepage": "https://design.baloise.dev",
  "security": "https://github.com/baloise/design-system/security/advisories/new",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "_dev": "====================================================== Development ================================================",
    "start": "pnpm --filter @baloise/ds-core start",
    "start-two": "pnpm --filter @baloise/ds-core start-two",
    "start:force": "turbo run build --force && pnpm start",
    "docs": "turbo run build --filter=@baloise/ds-core && node scripts/build-docs.mjs --serve && storybook dev -p 6006 --config-dir docs/.storybook",
    "docs:preview": "turbo run build --filter=@baloise/ds-core --force && node scripts/build-docs.mjs && http-server docs/dist -p 6006",
    "react:app": "bash test/react/build.sh v19 && bash test/react/start.sh v19",
    "angular:app": "bash test/angular/build.sh v22 && bash test/angular/start.sh v22",
    "_playwright": "=============================================== Playwright =================================================",
    "play": "pnpm --filter @baloise/ds-core play",
    "play:file": "pnpm --filter @baloise/ds-core play:file",
    "play:a11y": "pnpm --filter @baloise/ds-core play:a11y",
    "play:components": "pnpm --filter @baloise/ds-core play:components",
    "play:visual": "pnpm --filter @baloise/ds-core play:visual",
    "play:update": "pnpm --filter @baloise/ds-core play:update",
    "play:ci": "pnpm --filter @baloise/ds-core play:ci",
    "_build": "==================================================== Build =====================================================",
    "build": "turbo run build --filter=@baloise/ds-core && node scripts/build-docs.mjs",
    "build:force": "turbo run build --force",
    "tokens": "turbo run build --filter=@baloise/ds-tokens --force",
    "css": "turbo run build --filter=@baloise/ds-css --force",
    "assets": "turbo run build --filter=@baloise/ds-assets --force",
    "core": "turbo run build --filter=@baloise/ds-core --force",
    "_test": "===================================================== Test & Lint ===============================================",
    "lint": "turbo run lint && node scripts/check-overrides.mjs",
    "test": "turbo run test",
    "_utilities": "================================================ Utilities =================================================",
    "kill:ports": "node -e \"require('kill-port')(4000).catch(()=>{})\"",
    "format": "pnpm exec prettier --write --log-level error --end-of-line lf .",
    "format:check": "pnpm exec prettier --check --log-level error --end-of-line lf .",
    "spell": "cspell --no-progress",
    "changeset": "node scripts/create-changeset.mjs",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile --lockfile-only"
  },
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@changesets/get-github-info": "0.8.0",
    "@changesets/types": "6.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@stencil/core": "catalog:",
    "@stencil/react-output-target": "1.6.1",
    "@stencil/sass": "3.2.3",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/html-vite": "catalog:",
    "@swc/cli": "0.8.1",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript-eslint/utils": "catalog:",
    "@vitest/ui": "4.1.10",
    "archiver": "8.0.0",
    "compression": "catalog:",
    "cross-env": "7.0.3",
    "cspell": "10.0.1",
    "dotenv": "8.6.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.10.5",
    "express": "catalog:",
    "fast-deep-equal": "catalog:",
    "fast-glob": "3.3.3",
    "fs-extra": "catalog:",
    "glob": "13.0.6",
    "js-yaml": "4.3.0",
    "jsdom": "29.1.1",
    "jsonc-eslint-parser": "3.1.0",
    "kill-port": "2.0.1",
    "lodash": "catalog:",
    "prettier": "3.9.6",
    "prompts": "2.4.2",
    "rimraf": "6.1.3",
    "sass": "catalog:",
    "serve-index": "catalog:",
    "storybook": "catalog:",
    "style-dictionary": "5.5.0",
    "svgo": "4.0.2",
    "tsx": "catalog:",
    "turbo": "2.10.7",
    "typescript": "catalog:",
    "typescript-eslint": "8.65.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-linux-arm64-gnu": "0.141.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.141.0"
  },
  "pnpm": {
    "_comment": "overrides below kept in sync with pnpm-workspace.yaml — required for Vercel installs. See docs/adr/0005-duplicate-pnpm-overrides.md",
    "overrides": {
      "brace-expansion@<5.0.8": "5.0.8",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "js-yaml@>=3.0.0 <3.15.0": "3.15.0",
      "immutable@>=5.0.0-beta.1 <5.1.8": "5.1.8"
    }
  }
}
