{
  "name": "design-system",
  "version": "0.0.0",
  "homepage": "https://design.baloise.dev",
  "security": "https://github.com/baloise/design-system/security/advisories/new",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "_dev": "====================================================== Development ================================================",
    "start": "turbo run build --filter=@helvetia-design/styles && pnpm --filter @helvetia-design/core start",
    "start-two": "turbo run build --filter=@helvetia-design/styles && pnpm --filter @helvetia-design/core start-two",
    "start:force": "npm run styles && pnpm --filter @helvetia-design/core start",
    "docs": "turbo run build --filter=@helvetia-design/core --filter=@helvetia-design/ag-grid && node scripts/build-docs.mjs --serve && storybook dev -p 6006 --config-dir apps/storybook/.storybook",
    "docs:preview": "turbo run build --filter=@helvetia-design/core --filter=@helvetia-design/ag-grid --force && node scripts/build-docs.mjs && http-server apps/storybook/dist -p 6006",
    "toky": "pnpm --filter toky dev",
    "app:react": "turbo run build --filter=@helvetia-design/core --filter=@helvetia-design/react --filter=@helvetia-design/styles && pnpm --filter integration-react start",
    "app:angular": "turbo run build --filter=@helvetia-design/core --filter=@helvetia-design/angular --filter=@helvetia-design/styles && pnpm --filter integration-angular start",
    "app:next": "turbo run build --filter=@helvetia-design/core --filter=@helvetia-design/react --filter=@helvetia-design/styles && pnpm --filter integration-next start",
    "app:ssr": "turbo run build --filter=@helvetia-design/core --filter=@helvetia-design/styles && pnpm --filter integration-ssr start",
    "_playwright": "=============================================== Playwright =================================================",
    "play": "pnpm --filter @helvetia-design/core play",
    "play:file": "pnpm --filter @helvetia-design/core play:file",
    "play:a11y": "pnpm --filter @helvetia-design/core play:a11y",
    "play:components": "pnpm --filter @helvetia-design/core play:components",
    "play:visual": "pnpm --filter @helvetia-design/core play:visual",
    "play:update": "pnpm --filter @helvetia-design/core play:update",
    "play:ci": "pnpm --filter @helvetia-design/core play:ci",
    "_build": "==================================================== Build =====================================================",
    "build": "turbo run build --filter=@helvetia-design/core --filter=@helvetia-design/react --filter=@helvetia-design/angular --filter=@helvetia-design/ag-grid && node scripts/build-docs.mjs",
    "build:vercel": "turbo run build --filter=@helvetia-design/core --filter=@helvetia-design/ag-grid && node scripts/build-docs.mjs",
    "build:force": "turbo run build --force --filter=@helvetia-design/core --filter=@helvetia-design/react --filter=@helvetia-design/angular --filter=@helvetia-design/ag-grid && node scripts/build-docs.mjs",
    "tokens": "turbo run build --filter=@helvetia-design/tokens --force",
    "tokens:usage": "node scripts/generate-token-usage.mjs",
    "styles": "turbo run build --filter=@helvetia-design/styles --force",
    "assets": "turbo run build --filter=@helvetia-design/assets --force",
    "core": "turbo run build --filter=@helvetia-design/core --force",
    "_test": "===================================================== Test & Lint ===============================================",
    "lint": "turbo run lint && node scripts/check-overrides.mjs",
    "test": "turbo run test",
    "test:figma-sync": "vitest run --config scripts/figma-sync/vitest.config.ts",
    "figma-sync:dry-run": "node --env-file=.env scripts/figma-sync/pull.mjs",
    "figma-sync:pull": "cross-env DRY_RUN=false node --env-file=.env scripts/figma-sync/pull.mjs",
    "figma-sync:backfill:local": "node --env-file=.env scripts/figma-sync/backfill-commit.mjs",
    "figma-sync:conflict-check:local": "node --env-file=.env scripts/figma-sync/conflict-check.mjs",
    "test:token-usage": "vitest run --config scripts/token-usage/vitest.config.ts",
    "_utilities": "================================================ Utilities =================================================",
    "kill:ports": "node -e \"require('kill-port')(4000).catch(()=>{})\" && node -e \"require('kill-port')(6006).catch(()=>{})\"",
    "format": "pnpm exec prettier --write --log-level error --end-of-line lf .",
    "format:check": "pnpm exec prettier --check --log-level error --end-of-line lf .",
    "spell": "cspell --no-progress",
    "changeset": "node scripts/create-changeset.mjs",
    "changeset:version": "changeset version && node scripts/format-changelog.mjs && node scripts/sync-codepen-version.mjs && pnpm install --no-frozen-lockfile --lockfile-only"
  },
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/get-github-info": "1.0.1",
    "@changesets/types": "7.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@stencil/core": "catalog:",
    "@stencil/react-output-target": "1.6.2",
    "@stencil/sass": "3.2.3",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/html-vite": "catalog:",
    "@swc/cli": "0.8.1",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.13.5",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript-eslint/utils": "catalog:",
    "@vitest/ui": "4.1.11",
    "archiver": "8.0.0",
    "compression": "catalog:",
    "cross-env": "7.0.3",
    "cspell": "10.3.3",
    "dotenv": "18.0.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "10.1.8",
    "change-case": "5.4.4",
    "eslint-plugin-playwright": "2.12.0",
    "express": "catalog:",
    "fast-deep-equal": "catalog:",
    "fast-glob": "3.3.3",
    "fs-extra": "catalog:",
    "glob": "13.0.6",
    "js-yaml": "5.4.2",
    "jsdom": "30.1.0",
    "jsonc-eslint-parser": "3.3.0",
    "kill-port": "2.0.1",
    "lodash": "catalog:",
    "prettier": "3.9.8",
    "prompts": "2.4.2",
    "rimraf": "6.1.3",
    "sass": "catalog:",
    "serve-index": "catalog:",
    "storybook": "catalog:",
    "style-dictionary": "5.5.3",
    "svgo": "4.1.0",
    "tsx": "catalog:",
    "turbo": "2.10.13",
    "typescript": "catalog:",
    "typescript-eslint": "8.70.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-linux-arm64-gnu": "0.150.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.150.0"
  },
  "pnpm": {
    "_comment": "overrides below kept in sync with pnpm-workspace.yaml — required for Vercel installs. See docs/adr/0005-duplicate-pnpm-overrides.md",
    "overrides": {
      "brace-expansion@<5.0.9": "5.0.9",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "immutable@>=5.0.0-beta.1 <5.1.8": "5.1.8",
      "sharp@<0.35.0": "0.35.3",
      "postcss@<8.5.23": "8.5.26",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "@hono/node-server@<2.0.5": "2.1.0",
      "hono@<4.12.34": "4.13.1",
      "nanoid@<3.3.18": "3.3.18",
      "browserslist@<4.28.7": "4.28.8"
    }
  }
}
