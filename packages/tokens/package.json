{
  "name": "@helvetia-design/tokens",
  "version": "0.0.0",
  "description": "The Helvetia Design System is an open source project for styling awesome web applications that follow the Helvetia corporate styling guidelines.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baloise/design-system.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/js/base.tokens.js",
  "module": "dist/js/base.tokens.js",
  "style": "dist/css/base.tokens.css",
  "exports": {
    ".": "./dist/js/base.tokens.js",
    "./css-preview": "./dist/out-tsc/css-preview.js",
    "./dist/docs/base.tokens.json": "./dist/docs/base.tokens.json",
    "./css/base": "./dist/css/base.tokens.css",
    "./css/base-override": "./dist/css/base.override.css",
    "./css/orange-vacations": "./dist/css/orange-vacations.tokens.css",
    "./css/orange-vacations-override": "./dist/css/orange-vacations.override.css"
  },
  "scripts": {
    "build": "pnpm exec tsc && node dist/out-tsc",
    "build:clean": "rimraf dist",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "homepage": "https://helvetia-design.vercel.app",
  "security": "https://github.com/baloise/design-system/security/advisories/new",
  "license": "Apache-2.0",
  "files": [
    "dist/"
  ]
}
