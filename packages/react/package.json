{
  "name": "@helvetia-design/react",
  "version": "0.0.0",
  "description": "The Helvetia Design System is an open source project for styling awesome web applications that follow the Helvetia corporate styling guidelines.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baloise/design-system.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://design.baloise.dev",
  "security": "https://github.com/baloise/design-system/security/advisories/new",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.server.d.ts",
        "default": "./dist/index.server.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && node scripts/patch-server-wrappers.mjs",
    "build:clean": "rimraf dist",
    "lint": "eslint .",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@helvetia-design/core": "0.0.0",
    "@stencil/react-output-target": "1.6.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
