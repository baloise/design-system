{
  "name": "@baloise/ds-css",
  "version": "20.0.0-next.9",
  "description": "UnoCSS utility preset and pre-built CSS bundle for the Helvetia Design System.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baloise/design-system.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://baloise-design-system.vercel.app",
  "security": "https://github.com/baloise/design-system/security/advisories/new",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/preset/index.js",
      "require": "./dist/preset/index.cjs"
    },
    "./css": "./dist/css/design-system.css",
    "./css/all": "./dist/css/design-system.css",
    "./css/all.min": "./dist/css/design-system.min.css",
    "./css/all.local": "./dist/css/design-system.local.css",
    "./css/all.local.min": "./dist/css/design-system.local.min.css",
    "./css/base": "./dist/css/base.css",
    "./css/base.min": "./dist/css/base.min.css",
    "./css/base.local": "./dist/css/base.local.css",
    "./css/base.local.min": "./dist/css/base.local.min.css",
    "./css/components": "./dist/css/components.css",
    "./css/components.min": "./dist/css/components.min.css",
    "./css/utilities": "./dist/css/utilities.css",
    "./css/utilities.min": "./dist/css/utilities.min.css",
    "./scss/all": "./dist/scss/design-system.scss",
    "./scss/base": "./dist/scss/base.scss",
    "./scss/mixins": "./dist/scss/mixins.scss",
    "./scss/utilities": "./dist/scss/utilities.scss"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node --import tsx/esm src/build.ts"
  },
  "dependencies": {
    "@baloise/ds-assets": "20.0.0-next.9",
    "@baloise/ds-tokens": "20.0.0-next.9"
  },
  "devDependencies": {
    "autoprefixer": "10.5.4",
    "cssnano": "9.0.3",
    "postcss": "8.5.28",
    "sass": "catalog:",
    "tsx": "catalog:",
    "unocss": "66.9.2"
  }
}
